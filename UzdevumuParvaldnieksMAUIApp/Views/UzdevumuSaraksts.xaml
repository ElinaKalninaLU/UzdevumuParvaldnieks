<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UzdevumuParvaldnieksMAUIApp.Views.UzdevumuSaraksts"
             x:Name="UzdevumuSarakstsLapa"
             Title="UzdevumuSaraksts" >
    <VerticalStackLayout>
        <Label 
            Text="Uzdevumu saraksts"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Button
            Text="Pievienot uzdevumu"
            Command="{Binding PievienotUzdevumuCommand}" />
        <CollectionView
            ItemsSource="{Binding Uzdevumi}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="LightGray" CornerRadius="5" Padding="10" Margin="5">
                        <StackLayout>
                            <Label Text="{Binding Nosaukums}" FontAttributes="Bold" />
                            <Label Text="{Binding Apraksts}" />
                            <Label Text="{Binding Termiņš, StringFormat='Termiņš: {0:dd.MM.yyyy}'}" />
                            <Button Text="Labot" Command="{Binding Source={x:Reference UzdevumuSarakstsLapa}, Path=BindingContext.LabotUzdevumuCommand}" CommandParameter="{Binding .}" />
                            <Button Text="Dzēst" Command="{Binding Source={x:Reference UzdevumuSarakstsLapa}, Path=BindingContext.DzestUzdevumuCommand}" CommandParameter="{Binding .}"/>

                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>