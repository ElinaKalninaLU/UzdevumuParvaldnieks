<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UzdevumuParvaldnieksMAUIApp.Views.UzdevumuSaraksts"
             Title="UzdevumuSaraksts">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <CollectionView
            ItemsSource="{Binding Uzdevumi}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="LightGray" CornerRadius="5" Padding="10" Margin="5">
                        <StackLayout>
                            <Label Text="{Binding Nosaukums}" FontAttributes="Bold" />
                            <Label Text="{Binding Apraksts}" />
                            <Label Text="{Binding Termiņš, StringFormat='Termiņš: {0:dd.MM.yyyy}'}" />
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>