<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UzdevumuParvaldnieksMAUI.Views.UzdevumuSaraksts"
             Title="UzdevumuSaraksts" NavigatedTo="ContentPage_NavigatedTo">
    <VerticalStackLayout>
        <Label 
            x:Name="lblText"
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <CollectionView ItemsSource="{Binding UzdevumuSaraksts}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout>
                        <Label Text="{Binding Nosaukums}" />
                        <Label Text="{Binding Apraksts}" />
                        <Button Text="Labot"></Button>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>